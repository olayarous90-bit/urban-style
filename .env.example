# Configuración del Servidor URBAN STYLE
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Credenciales de API Mi Paquete v2 (Colombia)
# Entorno Dev/Sandbox: https://api-v2.dev.mpr.mipaquete.com
# Entorno Producción: https://api-v2.mpr.mipaquete.com
MIPAQUETE_BASE_URL=https://api-v2.dev.mpr.mipaquete.com
MIPAQUETE_APIKEY=
MIPAQUETE_SESSION_TRACKER=
MIPAQUETE_EMAIL=pruebasmipaqueteoficial@gmail.com

# Datos de Despacho Remitente (Origen del Comercio URBAN STYLE)
ORIGIN_DANE_CODE=11001000
ORIGIN_CITY=BOGOTÁ D.C.
ORIGIN_DEPARTMENT=BOGOTÁ D.C.
SENDER_NAME=URBAN STYLE S.A.S.
SENDER_NIT=901654321-1
SENDER_PHONE=3102345678
SENDER_ADDRESS=Calle 85 # 13-45, Zona Rosa, Bogotá
SENDER_EMAIL=despachos@urbanstyle.com.co

# Configuración de Correo Electrónico Automatizado (Nodemailer)
# Deja vacío en desarrollo para activar simulación y registro visual en server/logs/emails/
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="URBAN STYLE Despachos" <despachos@urbanstyle.com.co>

# Credenciales de Administrador por Defecto
ADMIN_DEFAULT_USER=admin
ADMIN_DEFAULT_PASS=UrbanStyle2026!
